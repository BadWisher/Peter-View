# Порт и cookie
PROOFREADER_PORT=3080
# true за TLS, иначе браузер не примет Secure cookie
PROOFREADER_COOKIE_SECURE=false
PROOFREADER_CORS_ORIGINS=
# Swagger UI. В проде оставь false
PROOFREADER_DOCS=false

# Дополнительные разделы. Вычитка, гайды, история и аналитика всегда включены
FEATURE_DOCUMENTS=false
FEATURE_API=false
FEATURE_WATCH=false
FEATURE_SCREENSHOTS=false

# Корп-прокси на VDI: docker-compose.corp-proxy.yml
PROOFREADER_CORP_PROXY=false
# true: можно ходить за документами во внутреннюю сеть. На публичном хосте поставь false
PROOFREADER_SSRF_ALLOW_PRIVATE=true
PROOFREADER_MAX_FETCH_BYTES=10485760
DOCX_MAX_UNCOMPRESSED_BYTES=314572800
DOCX_MAX_COMPRESSION_RATIO=200

# Языковая модель. Пусто = полная проверка выключена, пока админ не задаст свой эндпоинт
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_CONCURRENCY=4
LLM_TIMEOUT=180
PIPELINE_VERSION=v2
PIPELINE_SHADOW=false
RAG_CONFIG_VERSION=v2
PIPELINE_V2_STAGES=evidence,language,guide,structure,terminology,consistency,lexicon,verifier
PIPELINE_V2_PASS_TIMEOUT=360
PIPELINE_V2_PASS_RETRIES=2
LLM_JSON_MODE=true
LLM_REASONING_EFFORT=low

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# OIDC. Пустой OIDC_ISSUER = только локальный логин
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ADMIN_GROUPS=

JIRA_BASE_URL=
BACKUP_DIR=/app/backups
BACKUP_KEEP=7
